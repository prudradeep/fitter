# Dr Transition environment template
#
# Hosted backend:
# - Copy this file to .env on the backend server.
# - Replace every placeholder before production use.
# - Keep this file and all production .env files out of Windows installer payloads.
#
# Windows desktop client:
# - The installer writes a no-secret runtime override to:
#   %ProgramData%\DrTransition\.env
# - Per-user overrides may be placed at:
#   %LOCALAPPDATA%\DrTransition\.env
# - Desktop clients only need the DR_TRANSITION_* and OLLAMA_* keys near the end
#   of this file. They do not need DATABASE_URL or backend secrets.

# ---------------------------------------------------------------------------
# Hosted backend identity and safety
# ---------------------------------------------------------------------------

APP_NAME="Dr Transition"
APP_ENV=development
APP_DEBUG=true
SECRET_KEY="change-this-secret-key-before-production"

# In production these default to secure values when unset. They are explicit
# here so local development behavior is obvious.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_MAX_AGE_SECONDS=1209600
CSRF_PROTECTION_ENABLED=false

# Keep false outside development. Run schema migrations explicitly during
# deployment.
DATABASE_AUTO_MIGRATE=false

# ---------------------------------------------------------------------------
# Hosted backend database
# ---------------------------------------------------------------------------

DATABASE_URL="mysql+pymysql://drtransition:<choose-a-strong-password>@127.0.0.1:3306/drtransition"
# If the password contains URL-reserved characters, encode them.
# Example: @ -> %40, # -> %23, / -> %2F, : -> %3A
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=3600
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Hosted backend API/security surface
# ---------------------------------------------------------------------------

# Include the hosted web origin and any desktop/WebView origins used by the
# Windows app. Tighten this list for production.
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"

LOG_LEVEL=INFO
STRUCTURED_LOGS=false
REQUEST_ID_HEADER="X-Request-ID"
ACCESS_LOG_ENABLED=true
ACCESS_LOG_SUPPRESSED_PATHS="/health,/health/live,/health/ready"
ACCESS_LOG_SAMPLE_RATE=1.0

# Leave blank to use environment-specific defaults from app/config.py.
# CONTENT_SECURITY_POLICY=""
REFERRER_POLICY="strict-origin-when-cross-origin"
PERMISSIONS_POLICY="camera=(), microphone=(self), geolocation=(), payment=(), usb=()"
STRICT_TRANSPORT_SECURITY="max-age=31536000; includeSubDomains"

# ---------------------------------------------------------------------------
# Hosted backend request limits
# ---------------------------------------------------------------------------

MAX_UPLOAD_BYTES=10485760
MAX_SESSION_IMPORT_BYTES=10485760
MAX_URL_INGEST_BYTES=10485760
MAX_JSON_BYTES=1048576

# ---------------------------------------------------------------------------
# Hosted backend rate limits and retention
# ---------------------------------------------------------------------------

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=900
SIGNUP_RATE_LIMIT_ATTEMPTS=5
SIGNUP_RATE_LIMIT_WINDOW_SECONDS=3600
SIGNUP_RATE_LIMIT_LOCKOUT_SECONDS=3600
PASSWORD_RATE_LIMIT_ATTEMPTS=5
PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
PASSWORD_RATE_LIMIT_LOCKOUT_SECONDS=900

RATE_LIMIT_RETENTION_DAYS=7
TEMPORARY_KNOWLEDGE_RETENTION_HOURS=24
LLM_LOG_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Hosted backend knowledge/admin imports
# ---------------------------------------------------------------------------

# The migrated Windows client generates embeddings locally for synced KB data.
# These keys remain for hosted admin import/search compatibility and legacy
# maintenance paths. Do not require Ollama on hosted request paths. Ollama
# connection settings are defined once in the shared section below.
FAISS_INDEX_PATH="data/knowledge.faiss"

# Optional dedicated grounding services. Leave empty unless separately hosted.
RERANKER_URL=""
RERANKER_TIMEOUT_SECONDS=60
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
NLI_URL=""
NLI_TIMEOUT_SECONDS=60
NLI_MODEL="cross-encoder/nli-deberta-v3-small"

# ---------------------------------------------------------------------------
# Hosted backend LLM/audit logging
# ---------------------------------------------------------------------------

# Production default recommendation after the client LLM/RAG migration:
LLM_LOG_ENABLED=false
LLM_LOG_TO_FILE=false
LLM_LOG_TO_DB=false
LLM_LOG_INCLUDE_PAYLOADS=false
LLM_LOG_ALLOW_PRODUCTION_PAYLOADS=false
LLM_LOG_PATH="data/service-runtime/logs/llm_requests.jsonl"
LLM_LOG_MAX_PAYLOAD_CHARS=120000
LLM_LOG_MAX_TEXT_CHARS=8000

# ---------------------------------------------------------------------------
# Validation tuning
# ---------------------------------------------------------------------------

MITIGATION_VERDICT_SAMPLES=3
MITIGATION_CONTRADICTION_RESAMPLES=2
MITIGATION_CONTRADICTION_CONFIRMATION_FRACTION=0.4
MITIGATION_VERDICT_TEMPERATURE=0.25
MITIGATION_SUPPORT_SCORE_FLOOR=0.15

EUROSTAT_BASE_URL="https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data"
EUROSTAT_TIMEOUT_SECONDS=20
EUROSTAT_CACHE_EXPIRY_MONTHS=3

# ---------------------------------------------------------------------------
# Shared Ollama settings
# ---------------------------------------------------------------------------
#
# Hosted backend: optional, for admin import/search compatibility and legacy
# maintenance paths only.
# Windows desktop: local Ollama on the user's machine; required for local
# LLM/RAG workflows.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="mistral-nemo"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_TIMEOUT_SECONDS=1200

# ---------------------------------------------------------------------------
# Windows desktop client runtime overrides
# ---------------------------------------------------------------------------

# These keys are safe to store in %ProgramData%\DrTransition\.env or
# %LOCALAPPDATA%\DrTransition\.env. They contain no secrets.
DR_TRANSITION_BACKEND_URL="https://your-hosted-dr-transition.example/"

# Optional. If omitted, the desktop launcher derives these from
# DR_TRANSITION_BACKEND_URL.
DR_TRANSITION_BACKEND_HEALTH_URL="https://your-hosted-dr-transition.example/health/ready"
DR_TRANSITION_BACKEND_AUTH_CHECK_URL="https://your-hosted-dr-transition.example/api/sessions"

# Client-side reranker and entailment services bundled with the Windows app.
# These are localhost-only companion services and contain no MySQL/backend API.
DR_TRANSITION_GROUNDING_ENABLED=true
DR_TRANSITION_RERANKER_URL="http://127.0.0.1:8081/rerank"
DR_TRANSITION_RERANKER_HEALTH_URL="http://127.0.0.1:8081/health"
DR_TRANSITION_NLI_URL="http://127.0.0.1:8082/entail"
DR_TRANSITION_NLI_HEALTH_URL="http://127.0.0.1:8082/health"
