APP_NAME="Dr Transition"
APP_ENV=development
APP_DEBUG=true
SECRET_KEY="change-this-secret-key-before-production"
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_MAX_AGE_SECONDS=1209600
CSRF_PROTECTION_ENABLED=false
DATABASE_AUTO_MIGRATE=false

DATABASE_URL="mysql+pymysql://dr_transition:<choose-a-strong-local-password>@localhost:3306/dr_transition"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=3600
DATABASE_CONNECT_TIMEOUT_SECONDS=10

OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="mistral-nemo"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_TIMEOUT_SECONDS=120
LLM_LOG_ENABLED=true
LLM_LOG_TO_FILE=true
LLM_LOG_TO_DB=true
LLM_LOG_INCLUDE_PAYLOADS=true
LLM_LOG_ALLOW_PRODUCTION_PAYLOADS=false
LLM_LOG_MAX_PAYLOAD_CHARS=120000
LLM_LOG_MAX_TEXT_CHARS=8000
FAISS_INDEX_PATH="data/knowledge.faiss"
MAX_UPLOAD_BYTES=10485760
MAX_SESSION_IMPORT_BYTES=10485760
MAX_URL_INGEST_BYTES=10485760
MAX_JSON_BYTES=1048576
RERANKER_URL=""
RERANKER_TIMEOUT_SECONDS=60
NLI_URL=""
NLI_TIMEOUT_SECONDS=60
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
NLI_MODEL="cross-encoder/nli-deberta-v3-small"
MITIGATION_VERDICT_SAMPLES=3
MITIGATION_CONTRADICTION_RESAMPLES=2
MITIGATION_CONTRADICTION_CONFIRMATION_FRACTION=0.4
MITIGATION_VERDICT_TEMPERATURE=0.25
MITIGATION_SUPPORT_SCORE_FLOOR=0.15

SYNC_ENABLED=false
SYNC_MODE=client
SYNC_SERVER_URL=""
# Client mode: use a server-issued token created with scripts/create_sync_client.py.
# Server mode: optional legacy fallback token; admin KB permissions come from sync_clients rows.
SYNC_API_TOKEN=""
SYNC_DEVICE_ID=""
SYNC_BATCH_SIZE=500
SYNC_INCLUDE_LOGS=false
SYNC_SERVER_EXPOSE_APP_APIS=false
SYNC_AUTO_ON_STARTUP=true
SYNC_INTERVAL_SECONDS=3600

CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"
LOG_LEVEL=INFO
STRUCTURED_LOGS=false
REQUEST_ID_HEADER="X-Request-ID"
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=900
SIGNUP_RATE_LIMIT_ATTEMPTS=5
SIGNUP_RATE_LIMIT_WINDOW_SECONDS=3600
SIGNUP_RATE_LIMIT_LOCKOUT_SECONDS=3600
PASSWORD_RATE_LIMIT_ATTEMPTS=5
PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
PASSWORD_RATE_LIMIT_LOCKOUT_SECONDS=900
RATE_LIMIT_RETENTION_DAYS=7
TEMPORARY_KNOWLEDGE_RETENTION_HOURS=24
LLM_LOG_RETENTION_DAYS=30
SYSTEM_INQUIRY_PROFILE_RETENTION_DAYS=365
