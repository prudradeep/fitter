APP_NAME="Dr Transition Sync Server"
APP_MODE=server
APP_ENV=production
APP_DEBUG=false
SECRET_KEY="<strong unique random secret>"
AUTH_COOKIE_SECURE=true
CSRF_PROTECTION_ENABLED=true
DATABASE_AUTO_MIGRATE=false

DATABASE_URL="mysql+pymysql://drtransition:<password>@127.0.0.1:3306/drtransition"
SQLITE_DATABASE_PATH="data/dr_transition.db"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=3600
DATABASE_CONNECT_TIMEOUT_SECONDS=10

SYNC_ENABLED=true
SYNC_MODE=server
SYNC_SERVER_URL=""
SYNC_API_TOKEN=""
SYNC_DEVICE_ID="central-sync-server"
SYNC_INCLUDE_LOGS=false
SYNC_SERVER_EXPOSE_APP_APIS=false
SYNC_AUTO_ON_STARTUP=false
SYNC_INTERVAL_SECONDS=0

CORS_ORIGINS="https://your-sync-host.example"
STRUCTURED_LOGS=true
LLM_LOG_ENABLED=false
LLM_LOG_TO_FILE=false
LLM_LOG_TO_DB=false
LLM_LOG_INCLUDE_PAYLOADS=false
