APP_NAME="Dr Transition"
APP_ENV=production
APP_DEBUG=false
APP_MODE=cloud_server
SECRET_KEY="replace-with-a-long-random-secret"

# Server-only cloud MySQL credentials. Do not ship these to desktop clients.
DATABASE_URL="mysql+pymysql://dr_transition:replace-password@cloud-mysql-host:3306/dr_transition"

OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="mistral-nemo"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_TIMEOUT_SECONDS=1200
FAISS_INDEX_PATH="data/knowledge.faiss"

# Tokens used by desktop clients. Use different strong random values.
CENTRAL_SYNC_TOKEN="replace-with-sync-token"
CENTRAL_EVIDENCE_TOKEN="replace-with-evidence-token"
SYNC_BATCH_SIZE=100
SYNC_RATE_LIMIT_PER_MINUTE=120
EVIDENCE_RATE_LIMIT_PER_MINUTE=30

RERANKER_URL=""
RERANKER_TIMEOUT_SECONDS=60
NLI_URL=""
NLI_TIMEOUT_SECONDS=60
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
NLI_MODEL="cross-encoder/nli-deberta-v3-small"

CORS_ORIGINS="https://your-central-domain.example"
LOG_LEVEL=INFO
