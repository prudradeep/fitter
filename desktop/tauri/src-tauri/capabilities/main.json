{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-desktop-runtime",
  "description": "Allows the main desktop webview to use local runtime, Ollama, and knowledge-store commands.",
  "windows": ["main"],
  "local": true,
  "remote": {
    "urls": [
      "http://localhost:8000",
      "http://localhost:8000/*",
      "http://127.0.0.1:8000",
      "http://127.0.0.1:8000/*",
      "http://13.232.131.219",
      "http://13.232.131.219/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-runtime-status",
    "allow-runtime-config",
    "allow-ollama-model-status",
    "allow-ollama-embed-texts",
    "allow-ollama-chat",
    "allow-kb-store-status",
    "allow-kb-scope-manifest",
    "allow-kb-list-documents",
    "allow-kb-get-document",
    "allow-kb-upsert-documents",
    "allow-kb-delete-documents",
    "allow-kb-clear-temporary"
  ]
}
